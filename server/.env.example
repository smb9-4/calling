# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secure_private_calling_secret_key_992123

# Database path (defaults to ./calling.db)
DB_PATH=calling.db

# STUN / TURN Configuration for symmetric NAT and cellular mobile traversal
# By default, public Google STUN servers are used.
# For production mobile-to-mobile across restrictive cellular firewalls, configure a TURN server (Coturn / Metered.ca / Twilio):
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Web Push VAPID Keys (Auto-generated by server on first run if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@campus-connect.internal

